    {
      "name": "use-cursor",
      "type": "registry:hook",
      "title": "useCursor",
      "description": "The cursor engine every hover-ui cursor runs on: turns its parent element into a cursor area and calls your frame function while a mouse is inside.",
      "categories": [
        "Hooks"
      ],
      "files": [
        {
          "path": "hooks/use-cursor.ts",
          "type": "registry:hook"
        }
      ]
    }
  ]
}
